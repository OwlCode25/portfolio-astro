---
import Image from 'astro/components/Image.astro';
interface Props {
  name: string;
  desc: string;
  images: { src: any; alt: string; lgName: string }[];
  url: string
}

const { name, desc, images, url } = Astro.props;
---

<a href={url} class="cursor-pointer block h-full group/card" rel="noreferrer" target="_blank">
  <figure class="relative flex flex-col items-center h-full justify-center p-6 sm:p-8 text-center border rounded bg-surface border-[rgba(56,189,248,0.15)] transition-all duration-300 overflow-hidden hover:border-[rgba(56,189,248,0.3)]">
    <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-blue-bright/40 to-transparent"></div>
    <blockquote class="max-w-2xl mx-auto mb-4 lg:mb-6">
      <h3 class="text-xl font-bold text-[#e2e8f0] mb-3 text-balance">{name}</h3>
      <p class="my-4 text-[#94a3b8] text-sm leading-relaxed text-pretty">{desc}</p>
    </blockquote>

    <figcaption class="flex flex-wrap items-center justify-center gap-4">
      {images.map((image) => (
        <div class="flex flex-col items-center group">
          <div class="w-12 h-12 bg-[#e2e8f0] rounded-full p-2 flex items-center justify-center shadow-sm transition-transform duration-300 group-hover:scale-110">
            <Image src={image.src} width="100" height="100" class="w-8 h-8 object-contain" alt={image.alt} />
          </div>
          <div class="mt-2">
            <div class="text-xs font-medium text-[#94a3b8]">{image.lgName}</div>
          </div>
        </div>
      ))}
    </figcaption>

    <div class="mt-6 inline-flex items-center gap-1.5 border border-blue-bright text-blue-bright px-4 py-2 font-oswald uppercase tracking-widest text-xs transition-all duration-200 group-hover/card:bg-blue-bright group-hover/card:text-white">
      Ver proyecto
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
        <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
        <path d="M17 7l-10 10"></path>
        <path d="M8 7l9 0l0 9"></path>
      </svg>
    </div>
  </figure>
</a>
