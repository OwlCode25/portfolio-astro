---
const services = [
  {
    id: "apps",
    title: "Desarrollo de Aplicaciones",
    description: "Aplicaciones web, móviles y de escritorio a medida, construidas con tecnologías modernas y listas para escalar.",
    chips: ["Web (React / Astro)", "Móvil (iOS & Android)", "APIs REST / GraphQL", "Dashboards"],
    featured: false,
    svg: `<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" stroke-width="1.5" stroke="#38bdf8" fill="none" stroke-linecap="round" stroke-linejoin="round">
      <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
      <polyline points="7 8 3 12 7 16" />
      <polyline points="17 8 21 12 17 16" />
      <line x1="14" y1="4" x2="10" y2="20" />
    </svg>`,
  },
  {
    id: "ai",
    title: "Automatización con IA",
    description: "Flujos inteligentes y agentes especializados que reducen trabajo manual y potencian tu negocio.",
    chips: ["Contenido para redes sociales", "Agentes especializados", "Bots y asistentes", "Workflows automáticos"],
    featured: true,
    svg: `<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" stroke-width="1.5" stroke="#38bdf8" fill="none" stroke-linecap="round" stroke-linejoin="round">
      <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
      <rect x="3" y="8" width="18" height="12" rx="2" />
      <path d="M12 8v-4" />
      <circle cx="12" cy="4" r="1" />
      <line x1="8" y1="14" x2="8" y2="14.01" />
      <line x1="16" y1="14" x2="16" y2="14.01" />
      <path d="M9 18h6" />
    </svg>`,
  },
  {
    id: "integration",
    title: "Integración de Sistemas",
    description: "Conecta tus herramientas, plataformas y datos existentes sin fricciones ni silos de información.",
    chips: ["APIs & Webhooks", "ERPs & CRMs", "Migración de datos", "Cloud platforms"],
    featured: false,
    svg: `<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" stroke-width="1.5" stroke="#38bdf8" fill="none" stroke-linecap="round" stroke-linejoin="round">
      <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
      <circle cx="12" cy="5" r="2" />
      <circle cx="5" cy="19" r="2" />
      <circle cx="19" cy="19" r="2" />
      <path d="M12 7v5" />
      <path d="m9.5 17.5 -2.5 -4.5" />
      <path d="m14.5 17.5 2.5 -4.5" />
    </svg>`,
  },
];
---

<section id="services" class="py-16 animate-fade-in animate-once animate-duration-700 animate-delay-100">
  <div class="max-w-screen-xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section heading -->
    <div class="text-center mb-12">
      <h2 class="font-oswald text-3xl font-bold uppercase tracking-[0.03em] text-[#e2e8f0] text-balance">
        ¿En qué puedo ayudarte?
      </h2>
    </div>

    <!-- Service cards grid -->
    <div class="services-grid grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-10">
      {services.map((service) => (
        <div
          class={`service-card group relative flex flex-col rounded border bg-surface p-6 sm:p-8 transition-all duration-300 overflow-hidden ${
            service.featured
              ? "border-[rgba(56,189,248,0.3)] hover:border-[rgba(56,189,248,0.5)]"
              : "border-[rgba(56,189,248,0.15)] hover:border-[rgba(56,189,248,0.3)]"
          }`}
        >
          <!-- Top accent line -->
          <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-blue-bright/40 to-transparent"></div>

          <!-- Icon container -->
          <div class="mb-5 w-12 h-12 rounded-xl bg-blue-bright/10 flex items-center justify-center flex-shrink-0">
            <Fragment set:html={service.svg} />
          </div>

          <!-- Title -->
          <h3 class="text-xl font-bold text-[#e2e8f0] mb-2 text-balance">
            {service.title}
          </h3>

          <!-- Description -->
          <p class="text-[#94a3b8] text-sm sm:text-base text-pretty mb-5 flex-grow leading-relaxed">
            {service.description}
          </p>

          <!-- Sub-service chips -->
          <div class="flex flex-wrap gap-2 mb-6">
            {service.chips.map((chip) => (
              <span class="text-xs px-3 py-1 rounded-full bg-[rgba(56,189,248,0.08)] text-[#94a3b8] border border-[rgba(56,189,248,0.2)] leading-tight">
                {chip}
              </span>
            ))}
          </div>

          <!-- Individual CTA -->
          <a
            href="/contact"
            class="inline-flex items-center justify-center gap-1.5 self-start border border-blue-bright text-blue-bright px-4 py-2 font-oswald uppercase tracking-widest text-xs hover:bg-blue-bright hover:text-white transition-all duration-200 active:scale-[0.96]"
          >
            Consultar
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
            </svg>
          </a>
        </div>
      ))}
    </div>

    <!-- Global CTA strip -->
    <div class="border-t border-[rgba(56,189,248,0.15)] px-8 py-10 text-center mt-4">
      <h3 class="font-oswald text-2xl font-bold uppercase tracking-[0.03em] text-[#e2e8f0] mb-2 text-balance">
        ¿Tienes un proyecto en mente?
      </h3>
      <p class="text-[#94a3b8] text-sm text-pretty mb-6 max-w-md mx-auto">
        Cuéntame tu idea y encontramos juntos la mejor solución para tu negocio.
      </p>
      <a
        href="/contact"
        class="inline-flex items-center gap-2 rounded-lg bg-accent-gold px-6 py-3 text-base font-semibold text-blue-royal shadow-md transition-all duration-300 hover:brightness-110 active:scale-[0.97]"
      >
        Hablemos
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
        </svg>
      </a>
    </div>

  </div>
</section>

<style>
  .services-grid .service-card:nth-child(1) { animation-delay: 0.1s; }
  .services-grid .service-card:nth-child(2) { animation-delay: 0.3s; }
  .services-grid .service-card:nth-child(3) { animation-delay: 0.5s; }
</style>
