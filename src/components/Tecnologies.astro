/**
 * Kept deliberately apart and quieter: none of this is a capability anyone
 * buys, so it must not compete with the rows above. It stays because it is
 * the honest answer to how the work gets done.
 */
const environment: Tech[] = [
  { name: "Arch Linux", icon: icons.archlinux, link: "https://archlinux.org/" },
  { name: "macOS", icon: icons.apple, link: "https://www.apple.com/macos/" },
  { name: "Hyprland", icon: icons.hyprland, link: "https://hypr.land/" },
  { name: "Kitty", icon: CAT, link: "https://sw.kovidgoyal.net/kitty/" },
  { name: "Tmux", icon: icons.tmux, link: "https://github.com/tmux/tmux" },
  { name: "Neovim", icon: icons.neovim, link: "https://neovim.io/" },
  { name: "Herdr", mono: "HR", link: "https://github.com/herdrdev/herdr" },
  { name: "Handy", mono: "HY", link: "https://handy.computer/" },
  { name: "Whisper", mono: "W", link: "https://github.com/openai/whisper" },
];

---

<section id="skills" class="py-12 sm:py-16 md:py-20">
  <div class="max-w-screen-xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="font-display font-extralight text-3xl md:text-4xl uppercase tracking-[0.03em] text-ink">
        Stack &amp; Herramientas
      </h2>
    </div>

    <div class="space-y-9 animate-fade-in animate-once animate-duration-700">
      {groups.map((group) => (
        <div>
          <h3 class="font-bold text-xs uppercase tracking-widest text-ink mb-3">
            {group.headline}
          </h3>
          <ul class="flex flex-wrap gap-2">
            {group.techs.map((tech) => (
              <li>
                <TechChip tech={tech} />
              </li>
            ))}
          </ul>
        </div>
      ))}

      <div class="pt-7 border-t border-brand-accent/10">
        <h3 class="font-bold text-xs uppercase tracking-widest text-ink-muted mb-3">
          Entorno
        </h3>
        <ul class="flex flex-wrap gap-2">
          {environment.map((tech) => (
            <li>
              <TechChip tech={tech} muted />
            </li>
          ))}
        </ul>
      </div>

    </div>
  </div>
</section>
