---
import { icons } from "../data/tech-icons";
import TechChip from "./TechChip.astro";

/**
 * One technology chip.
 *
 * `icon` is a simple-icons path string. When a technology has no entry in
 * simple-icons (Dokploy, Herdr and Hermes Agent are too new to have one),
 * `mono` carries a short letterform
 * instead. In a palette this restricted a letter reads as an icon, so the
 * fallback costs nothing visually.
 */
interface Tech {
  name: string;
  icon?: string;
  mono?: string;
  link?: string;
}

/**
 * Kitty has no simple-icons entry, and nothing feline exists there either, so
 * this is drawn by hand on the same 24x24 grid as the rest: one solid
 * silhouette with the eyes cut out as reverse subpaths. It is a generic cat,
 * not a copy of Kitty's mark. Verified legible at the 16px it actually renders
 * at — the ears are what carry it once the eyes go muddy.
 */
const CAT = "M4.6 3.2 L9.9 8.9 A6.3 6.3 0 0 1 14.1 8.9 L19.4 3.2 L18.1 12.2 A6.3 6.3 0 1 1 5.9 12.2 Z M9.7 14.4 a1.3 1.3 0 1 0 .01 0 Z M14.3 14.4 a1.3 1.3 0 1 0 .01 0 Z";

/**
 * Hermes Agent's mark is a detailed illustration — bangs, an eye, hair strands.
 * Traced whole it turned to mush at the 16px a chip actually renders at, so
 * this is only its outer contour, normalised onto the same 24x24 grid as the
