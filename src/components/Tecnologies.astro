interface Group {
  /** Verb-led, in the visitor's language: what they get, not what I install. */
  headline: string;
  techs: Tech[];
}

const groups: Group[] = [
  {
    headline: "Construyo aplicaciones a medida",
    techs: [
      { name: "Python", icon: icons.python, link: "https://www.python.org/" },
      { name: "Flask", icon: icons.flask, link: "https://flask.palletsprojects.com/" },
      { name: "Django", icon: icons.django, link: "https://www.djangoproject.com/" },
      { name: "FastAPI", icon: icons.fastapi, link: "https://fastapi.tiangolo.com/" },
      { name: "TypeScript", icon: icons.typescript, link: "https://www.typescriptlang.org/" },
      { name: "Astro", icon: icons.astro, link: "https://astro.build/" },
      { name: "React", icon: icons.react, link: "https://react.dev/" },
      { name: "Tailwind", icon: icons.tailwindcss, link: "https://tailwindcss.com/" },
      { name: "Expo", icon: icons.expo, link: "https://expo.dev/" },
      { name: "Tauri", icon: icons.tauri, link: "https://tauri.app/" },
