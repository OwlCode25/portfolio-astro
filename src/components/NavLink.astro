---
// NavLink.astro - Componente para los enlaces individuales
export interface Props {
  href: string;
  icon: string;
  isContactLink?: boolean;
  text: string;
}

const { href, icon, isContactLink = false, text } = Astro.props;
---

<li>
  <a
    class="transition duration-300 hover:text-[#e2e8f0] hover:bg-[rgba(56,189,248,0.08)] text-[#94a3b8] hover:rounded-lg rounded-md p-2 flex items-center font-oswald text-[0.65rem] uppercase tracking-widest"
    href={href}
    data-contact={isContactLink ? 'true' : 'false'}
  >
    <span set:html={icon} />
    {text}
  </a>
</li>
