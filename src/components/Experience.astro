<script>
  // The rail's horizontal position is owned entirely by CSS (--rail-x), so it
  // cannot drift from the dots. All this does is span it between the first and
  // last dot, and it reads the dot's own geometry off the pseudo-element
  // rather than repeating any of those numbers here.
  function sizeRail() {
    const list = document.getElementById("experience-list");
    if (!list) return;

    const entries = list.querySelectorAll<HTMLElement>("li.timeline-entry");
    if (entries.length < 2) {
      list.style.setProperty("--rail-height", "0px");
      return;
    }

    // Measured per entry rather than once: assuming both dots sit at the same
    // offset inside their row happens to hold today, but it would break
    // silently the moment one entry got a different size.
    const dotCentre = (entry: HTMLElement) => {
      const dot = getComputedStyle(entry, "::before");
      return entry.offsetTop + parseFloat(dot.top) + parseFloat(dot.height) / 2;
    };

    const top = dotCentre(entries[0]);
    list.style.setProperty("--rail-top", `${top}px`);
    list.style.setProperty("--rail-height", `${dotCentre(entries[entries.length - 1]) - top}px`);
  }

  sizeRail();
  window.addEventListener("resize", sizeRail);
  // Web fonts land after first paint and change the line box the dot sits on.
  document.fonts?.ready.then(sizeRail);
</script>

<style>
  #experience-list {
    /* Single source of truth: the dot and the rail both centre on --rail-x,
       measured from the list's own left edge. Nothing may hardcode a position
       independently — that is exactly how they drifted apart before. */
    --rail-x: 5px;
    --rail-pad: 26px;
    --dot: 9px;

    position: relative;
    list-style: none;
    padding-left: var(--rail-pad);
  }

  /* The descriptions ran to ~179 characters per line on a wide screen, well
     past the 65-75 the eye can track without losing its place on the return
     sweep. Scoped to the prose rows only: titles and dates are short, and a
     measure written for paragraphs has no business wrapping them. */
  #experience-list li.timeline-detail {
    max-width: 68ch;
  }

  #experience-list::before {
    content: "";
    position: absolute;
    left: calc(var(--rail-x) - 0.5px);
    width: 1px;
    top: var(--rail-top, 0px);
    height: var(--rail-height, 0px);
    background: theme("colors.brand.accent / 30%");
  }

  #experience-list li.timeline-entry {
    position: relative;
    line-height: 1.5;
  }

  #experience-list li.timeline-entry::before {
    content: "";
    position: absolute;
    /* Offset back out of the list padding so this lands on --rail-x too. */
    left: calc(var(--rail-x) - var(--rail-pad) - var(--dot) / 2);
    top: calc(0.75em - var(--dot) / 2);
    width: var(--dot);
    height: var(--dot);
    border-radius: 9999px;
    background: theme("colors.brand.accent");
  }
</style>
