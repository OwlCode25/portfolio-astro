---

<!-- No entrance animation on the bar itself: those utilities leave a
     permanent `transform` behind, which would make this element the
     containing block for the fixed mobile sheet and anchor the sheet to the
     navbar instead of the viewport. -->
<nav class="bg-blueprint p-3 sm:p-4 md:p-6 border-b border-brand-accent/15 w-full sticky top-0 z-50">
  <div class="max-w-screen-xl flex flex-wrap items-center justify-between mx-auto px-2 sm:px-3 md:px-4">
    <a href="/" class="flex items-center py-1">
      <img src={logo} alt="OwlCode" class="h-8 sm:h-10 md:h-12 w-auto" />
    </a>

    <div class="flex md:order-2 space-x-2 md:space-x-3 rtl:space-x-reverse items-center">
      <a
        class="transition duration-200 ease-in bg-brand-accent/10 border border-brand-accent/20 text-ink-muted hover:bg-brand-accent/20 hover:text-ink rounded-full p-2 mr-10 cursor-pointer block lg:inline-block"
        href="https://www.github.com/OwlCode25"
        rel="noopener noreferrer"
        target="_blank"
        aria-label="GitHub Profile"
      >
        <svg class="w-5 h-5 sm:w-6 sm:h-6" viewBox="0 0 24 24" stroke-width="1.5" stroke="#7AA2F7" fill="none" stroke-linecap="round" stroke-linejoin="round">
          <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
          <path d="M5.315 2.1c.791 -.113 1.9 .145 3.333 .966l.272 .161l.16 .1l.397 -.083a13.3 13.3 0 0 1 4.59 -.08l.456 .08l.396 .083l.161 -.1c1.385 -.84 2.487 -1.17 3.322 -1.148l.164 .008l.147 .017l.076 .014l.05 .011l.144 .047a1 1 0 0 1 .53 .514a5.2 5.2 0 0 1 .397 2.91l-.047 .267l-.046 .196l.123 .163c.574 .795 .93 1.728 1.03 2.707l.023 .295l.007 .272c0 3.855 -1.659 5.883 -4.644 6.68l-.245 .061l-.132 .029l.014 .161l.008 .157l.004 .365l-.002 .213l-.003 3.834a1 1 0 0 1 -.883 .993l-.117 .007h-6a1 1 0 0 1 -.993 -.883l-.007 -.117v-.734c-1.818 .26 -3.03 -.424 -4.11 -1.878l-.535 -.766c-.28 -.396 -.455 -.579 -.589 -.644l-.048 -.019a1 1 0 0 1 .564 -1.918c.642 .188 1.074 .568 1.57 1.239l.538 .769c.76 1.079 1.36 1.459 2.609 1.191l.001 -.678l-.018 -.168a5.03 5.03 0 0 1 -.021 -.824l.017 -.185l.019 -.12l-.108 -.024c-2.976 -.71 -4.703 -2.573 -4.875 -6.139l-.01 -.31l-.004 -.292a5.6 5.6 0 0 1 .908 -3.051l.152 -.222l.122 -.163l-.045 -.196a5.2 5.2 0 0 1 .145 -2.642l.1 -.282l.106 -.253a1 1 0 0 1 .529 -.514l.144 -.047l.154 -.03z" stroke-width="0" fill="#7AA2F7" />
        </svg>
      </a>
      <button
        id="navbar-toggle"
        type="button"
        class="nav-toggle inline-flex items-center p-2 w-10 h-10 justify-center text-ink-muted rounded-lg lg:hidden hover:bg-brand-accent/15 hover:text-ink focus:outline-none focus:ring-2 focus:ring-brand-accent transition-colors duration-200"
        aria-controls="navbar-cta"
        aria-expanded="false"
        aria-label="Abrir menú"
      >
        <span class="nav-toggle-bars" aria-hidden="true">
          <span></span><span></span><span></span>
        </span>
      </button>
    </div>

    <div id="navbar-scrim" class="nav-scrim lg:hidden"></div>

    <div
      id="navbar-cta"
      class="nav-panel items-center justify-between w-full lg:flex lg:w-auto lg:order-1"
    >
      <ul class="nav-list flex flex-col font-medium w-full lg:w-auto lg:flex-row lg:space-x-6 gap-1 lg:gap-0">
        {navLinks.map(link => (
          <NavLink
            href={link.href}
            text={link.text}
            icon={link.icon}
            isContactLink={link.isContactLink}
          />
        ))}
      </ul>
    </div>
  </div>
</nav>

<script>
  const MOBILE = "(max-width: 1023px)";

  const toggle = document.getElementById("navbar-toggle");
  const panel = document.getElementById("navbar-cta");
  const scrim = document.getElementById("navbar-scrim");
  const isMobile = window.matchMedia(MOBILE);

  function focusables(): HTMLElement[] {
    if (!panel) return [];
    return Array.from(
      panel.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'),
    );
  }

  function isOpen() {
    return toggle?.getAttribute("aria-expanded") === "true";
  }

  /** Whatever the page had set inline before the sheet locked scrolling. */
  let previousBodyOverflow = "";

  function openMenu() {
    if (!toggle || !panel || !scrim) return;
    toggle.setAttribute("aria-expanded", "true");
    toggle.setAttribute("aria-label", "Cerrar menú");
    panel.dataset.open = "true";
    panel.removeAttribute("inert");
    scrim.dataset.open = "true";
    previousBodyOverflow = document.body.style.overflow;
    document.body.style.overflow = "hidden";
    focusables()[0]?.focus();
  }

  function closeMenu(returnFocus = true) {
    if (!toggle || !panel || !scrim) return;
    toggle.setAttribute("aria-expanded", "false");
    toggle.setAttribute("aria-label", "Abrir menú");
    delete panel.dataset.open;
    delete scrim.dataset.open;
    document.body.style.overflow = previousBodyOverflow;
    if (isMobile.matches) panel.setAttribute("inert", "");
    // Focus goes back to the control that owns the sheet — never left
    // stranded on a link that is about to become inert. Callers that pass
    // `false` are responsible for placing focus somewhere themselves.
    if (returnFocus) toggle.focus();
  }

  // The panel is only a dialog below `lg`. Above it, it is an ordinary inline
  // nav list and must carry neither dialog semantics nor `inert`.
  function syncViewport() {
    if (!panel) return;
    if (isMobile.matches) {
      panel.setAttribute("role", "dialog");
      panel.setAttribute("aria-modal", "true");
      panel.setAttribute("aria-label", "Menú de navegación");
      if (!isOpen()) panel.setAttribute("inert", "");
    } else {
      panel.removeAttribute("role");
      panel.removeAttribute("aria-modal");
      panel.removeAttribute("aria-label");
      panel.removeAttribute("inert");
      if (isOpen()) closeMenu(false);
    }
  }

  toggle?.addEventListener("click", () => (isOpen() ? closeMenu() : openMenu()));
  scrim?.addEventListener("click", () => closeMenu());

  document.addEventListener("keydown", (event) => {
    if (!isOpen()) return;
    if (event.key === "Escape") {
      closeMenu();
      return;
    }
    if (event.key !== "Tab") return;
    // Keep focus inside the sheet while it covers the page.
    const items = focusables();
    if (!items.length) return;
    const first = items[0];
    const last = items[items.length - 1];
    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first.focus();
    }
  });

  function scrollToSection(this: HTMLAnchorElement, event: Event) {
    const targetId = this.getAttribute("href");
    if (!targetId?.startsWith("#")) return;
    const target = document.querySelector<HTMLElement>(targetId);
    if (!target) return;

    event.preventDefault();
    if (isOpen()) closeMenu(false);

    const navbarHeight = document.querySelector("nav")?.offsetHeight ?? 0;
    window.scrollTo({
      top: target.offsetTop - navbarHeight - 20,
      behavior: "smooth",
    });

    // Land on the section that was asked for. Without this, marking the sheet
    // inert while the just-clicked link still holds focus makes the browser
    // dump focus onto <body>, losing the keyboard user's place entirely.
    target.setAttribute("tabindex", "-1");
    target.dataset.scrollTarget = "";
    target.focus({ preventScroll: true });
  }

  for (const link of document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')) {
    link.addEventListener("click", scrollToSection);
  }

  isMobile.addEventListener("change", syncViewport);
  syncViewport();
</script>

<style>
  /* Hamburger that folds into an X. Three bars so each one can be
     transformed independently — a single path could not morph cleanly. */
  .nav-toggle-bars {
    position: relative;
    display: block;
    width: 20px;
    height: 14px;
  }

  .nav-toggle-bars span {
    position: absolute;
    left: 0;
    right: 0;
    height: 2px;
    border-radius: 9999px;
    background: currentColor;
    transition:
      transform 0.34s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.18s ease;
  }

  .nav-toggle-bars span:nth-child(1) { top: 0; }
  .nav-toggle-bars span:nth-child(2) { top: 6px; }
  .nav-toggle-bars span:nth-child(3) { top: 12px; }

  .nav-toggle[aria-expanded="true"] .nav-toggle-bars span:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }
  .nav-toggle[aria-expanded="true"] .nav-toggle-bars span:nth-child(2) {
    opacity: 0;
    transform: scaleX(0.3);
  }
  .nav-toggle[aria-expanded="true"] .nav-toggle-bars span:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* Mobile: the menu is a half-height sheet rising from the bottom edge. */
  @media (max-width: 1023px) {
    .nav-scrim {
      position: fixed;
      inset: 0;
      z-index: 40;
      background: rgb(17 18 26 / 0.6);
      backdrop-filter: blur(2px);
      opacity: 0;
      /* visibility, not just opacity: a transparent scrim that stays visible
         would keep swallowing every click on the page underneath it. */
      visibility: hidden;
      transition:
        opacity 0.32s ease,
        visibility 0s linear 0.32s;
    }

    .nav-scrim[data-open="true"] {
      opacity: 1;
      visibility: visible;
      transition:
        opacity 0.32s ease,
        visibility 0s linear 0s;
    }

    .nav-panel {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 45;
      display: flex;
      height: 50vh;
      height: 50dvh;
      padding: 1.25rem 1.5rem calc(1.25rem + env(safe-area-inset-bottom));
      overflow-y: auto;
      align-items: flex-start;
      border-top: 1px solid rgb(122 162 247 / 0.2);
      border-radius: 8px 8px 0 0;
      background: theme("colors.blueprint");
      transform: translateY(100%);
      visibility: hidden;
      /* Exit is quicker than entry; the delayed visibility keeps the sheet
         present until it has finished sliding away. */
      transition:
        transform 0.28s cubic-bezier(0.4, 0, 1, 1),
        visibility 0s linear 0.28s;
    }

    .nav-panel[data-open="true"] {
      transform: translateY(0);
      visibility: visible;
      transition:
        transform 0.42s cubic-bezier(0.16, 1, 0.3, 1),
        visibility 0s linear 0s;
    }

    /* A half-screen sheet needs real touch targets, not the 10px desktop
       label size squeezed into 420px of height. */
    .nav-list :global(a) {
      min-height: 44px;
      padding: 0.75rem 0.5rem;
      font-size: 0.8rem;
    }

    .nav-list :global(svg) {
      width: 1.15rem;
      height: 1.15rem;
      margin-right: 0.6rem;
    }
  }

  /* A section focused as an in-page navigation landing spot is a cursor move,
     not a control taking focus, so it must not paint a ring around the whole
     section. Real controls keep theirs. */
  :global([data-scroll-target]:focus) {
    outline: none;
  }

  /* Opening the sheet moves focus into it, so the ring is now visible to
     keyboard users. Periwinkle is the system's only accent, focus included. */
  .nav-list :global(a:focus-visible) {
    outline: 2px solid theme("colors.brand.accent");
    outline-offset: 2px;
    border-radius: 0.375rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-panel,
    .nav-panel[data-open="true"],
    .nav-scrim,
    .nav-toggle-bars span {
      transition-duration: 0.01ms;
    }
  }

  /* Mejora para dispositivos pequeños */
  @media (max-width: 360px) {
    nav .max-w-screen-xl {
      padding-left: 0.5rem;
      padding-right: 0.5rem;
    }
  }
</style>
