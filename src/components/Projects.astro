---
import Project from "./Project.astro";
---

<section id="projects" class="py-16 animate-fade-in animate-once animate-duration-700 animate-delay-100">
  <div class="max-w-screen-xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <div class="flex items-center justify-center gap-3 mb-3">
        <h2 class="font-display font-extralight text-3xl uppercase tracking-[0.03em] text-ink text-balance">
          Proyectos reales en producción
        </h2>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="36"
          height="36"
          viewBox="0 0 24 24"
          fill="none"
          stroke="#7AA2F7"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="icon icon-tabler icons-tabler-outline icon-tabler-git-pull-request flex-shrink-0"
        >
          <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
          <path d="M6 18m-2 0a2 2 0 1 0 4 0a2 2 0 1 0 -4 0"></path>
          <path d="M6 6m-2 0a2 2 0 1 0 4 0a2 2 0 1 0 -4 0"></path>
          <path d="M18 18m-2 0a2 2 0 1 0 4 0a2 2 0 1 0 -4 0"></path>
          <path d="M6 8l0 8"></path>
          <path d="M11 6h5a2 2 0 0 1 2 2v8"></path>
          <path d="M14 9l-3 -3l3 -3"></path>
        </svg>
      </div>
      <p class="text-ink-muted text-sm max-w-md mx-auto text-pretty">
        Soluciones que ya están funcionando para empresas e instituciones.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
      <Project
        name="Difusser"
        desc="Estudio de contenido con inteligencia artificial: defines tu marca una vez (colores, tipografía y voz) y un agente convierte un brief de una línea en video o carrusel respetando ese manual — se autocorrige si algo se sale de la marca. Listo para publicar en Instagram, TikTok, LinkedIn, YouTube Shorts, Facebook y WhatsApp."
        images={[
          {
            src: "https://user-images.githubusercontent.com/25181517/183897015-94a058a6-b86e-4e42-a37f-bf92061753e5.png",
            alt: "React",
            lgName: "React",
          },
          {
            src: "https://github-production-user-asset-6210df.s3.amazonaws.com/62091613/261395532-b40892ef-efb8-4b0e-a6b5-d1cfc2f3fc35.png",
            alt: "React",
            lgName: "Vite",
          },
          {
            src: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/fastapi/fastapi-original.svg",
            alt: "FastAPI",
            lgName: "FastAPI",
          },
        ]}
        url="https://www.difusser.tech"
      />

      <Project
        name="ECOM ENERGY"
        desc="Sitio web para ECOM ENERGY, empresa de instalación de paneles solares y sistemas fotovoltaicos en la zona norte y centro de Chile. Presenta sus servicios para hogares, empresas e industria."
        images={[
          {
            src: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/astro/astro-original.svg",
            alt: "Astro",
            lgName: "Astro",
          },
          {
            src: "https://user-images.githubusercontent.com/25181517/202896760-337261ed-ee92-4979-84c4-d4b829c7355d.png",
            alt: "Tailwind",
            lgName: "TailwindCSS",
          },
        ]}
        url="https://www.ecomenergy.cl"
      />
    </div>
  </div>
</section>

<style>
  /* Animaciones para entrada de proyectos */
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  
  #projects .grid > * {
    animation: fadeIn 0.6s ease-out forwards;
    opacity: 0;
  }
  
  #projects .grid > :nth-child(1) { animation-delay: 0.1s; }
  #projects .grid > :nth-child(2) { animation-delay: 0.3s; }
</style>
