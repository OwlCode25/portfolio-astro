---
import OwlIcon from "./OwlIcon.astro";
---

<section class="relative z-10 mt-6 sm:mt-8 md:mt-10 px-4 sm:px-6 md:px-8 lg:px-10 max-w-screen-xl mx-auto animate-expand-vertically">
  <div class="flex flex-col lg:flex-row items-center gap-8 lg:gap-12">

    <!-- Left column: text content -->
    <div class="w-full lg:w-3/5 order-2 lg:order-1 text-center lg:text-left">

      <!-- Value proposition -->
      <h1 class="font-display font-extralight text-4xl sm:text-5xl md:text-6xl uppercase leading-[0.95] tracking-[-0.01em] text-ink">
        Software a medida<br />que impulsa tu negocio
      </h1>

      <!-- Subtitle -->
      <p class="text-sm text-ink-muted leading-relaxed max-w-md mt-4 mx-auto lg:mx-0">
        Desarrollo aplicaciones web y móviles, automatizo procesos con IA e integro tus sistemas — para que tu equipo deje de perder tiempo en tareas manuales.
      </p>

      <!-- Availability -->
      <div class="flex items-center gap-2 text-xs text-ink-muted mt-4 justify-center lg:justify-start">
        <span class="w-2 h-2 rounded-full bg-brand-accent shadow-[0_0_6px_#7AA2F7]"></span>
        Disponible para proyectos
      </div>

      <!-- CTAs -->
      <div class="mt-6 sm:mt-8 flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
        <a
          href="#services"
          class="inline-flex items-center justify-center border border-brand-accent text-brand-accent px-5 py-2.5 font-bold uppercase tracking-widest text-sm hover:bg-brand-accent hover:text-blueprint transition-all duration-200"
        >
          Ver servicios
        </a>
        <a
          href="/contact"
          class="inline-flex items-center justify-center gap-1 text-ink-muted text-sm hover:text-ink transition-colors"
        >
          Cuéntame tu proyecto
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- Right column: brand mark -->
    <div class="w-full sm:w-2/3 md:w-1/2 lg:w-2/5 order-1 lg:order-2 flex justify-center items-center mb-8 lg:mb-0">
      <div class="brand-mark w-48 sm:w-56 md:w-64 lg:w-80 aspect-square relative overflow-hidden rounded-full shadow-lg ring-2 ring-brand-accent/30 bg-surface flex items-center justify-center">
        <div class="brand-mark-glow absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(122,162,247,0.14),transparent_70%)]"></div>
        <svg class="brand-mark-orbit absolute inset-3" viewBox="0 0 100 100" fill="none" aria-hidden="true">
          <circle cx="50" cy="50" r="47" stroke="#7AA2F7" stroke-opacity="0.3" stroke-width="1" stroke-dasharray="3 9" stroke-linecap="round" />
          <circle cx="50" cy="3" r="2.2" fill="#7AA2F7" />
        </svg>
        <OwlIcon
          width="220"
          height="220"
          class="relative w-1/2 sm:w-[55%] h-auto drop-shadow-[0_12px_28px_rgba(122,162,247,0.35)] hover:scale-105 transition-all duration-300"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .animate-expand-vertically {
    animation: expandVertically 0.8s ease-out forwards;
  }

  @keyframes expandVertically {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .brand-mark-glow {
    animation: brandGlow 4s ease-in-out infinite;
  }

  .brand-mark-orbit {
    animation: brandOrbit 16s linear infinite;
    transform-origin: center;
  }

  @keyframes brandGlow {
    0%, 100% { opacity: 0.65; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.08); }
  }

  @keyframes brandOrbit {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .brand-mark-glow,
    .brand-mark-orbit {
      animation: none;
    }
  }
</style>
