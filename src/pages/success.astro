---
import ContactLayout from "../layouts/ContactLayout.astro";
---

<ContactLayout
  title="OwlCode - Mensaje enviado"
  description="Mensaje enviado correctamente. Te responderé a la brevedad."
  noindex
>

<div class="mx-auto mt-16 mb-20 flex flex-col items-center px-4">
<h3 class="font-display font-extralight text-2xl uppercase tracking-[0.03em] text-ink text-center">¡Tu mensaje fue enviado con éxito!</h3>
<p class="text-ink-muted text-sm text-center mt-4 max-w-md">No tardaré en responderte, muchas gracias por contactarme :]</p>
</div>

</ContactLayout>
