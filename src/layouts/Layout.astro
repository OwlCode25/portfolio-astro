---
import Footer from '../components/Footer.astro';
import Navigation from '../components/Navigation.astro';

interface Props {
	title: string;
	description?: string;
	ogImage?: string;
}

const {
	title,
	description = "Desarrollo de software a medida para empresas y emprendedores: aplicaciones web y móviles, automatización con IA e integración de sistemas.",
	ogImage = "/og-image.png",
} = Astro.props;

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : null;
const ogImageUrl = Astro.site ? new URL(ogImage, Astro.site).href : ogImage;

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "Person",
	name: "OwlCode",
	alternateName: "OwlCode25",
	jobTitle: "Desarrollador de Software Freelance",
	...(Astro.site ? { url: Astro.site.href } : {}),
	sameAs: ["https://www.github.com/OwlCode25"],
	knowsAbout: [
		"Desarrollo de Aplicaciones",
		"Automatización con IA",
		"Integración de Sistemas",
	],
};
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		{canonical && <link rel="canonical" href={canonical} />}
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{canonical && <meta property="og:url" content={canonical} />}
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:locale" content="es" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
<link rel="manifest" href="/site.webmanifest">
		<meta name="generator" content={Astro.generator} />
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,200;0,400;0,700;1,200;1,400;1,700&display=swap" rel="stylesheet">

		<title>{title}</title>
	</head>
	<body>
		<!--
THESIS: OwlCode's brand IS the interface — periwinkle-on-near-black replaces the ad-hoc cyan/gold "Blueprint" look; the tech-owl mark and its two-color contrast carry authority, not decoration.
OWN-WORLD: #7AA2F7 periwinkle (sole accent: borders, icons, CTAs, focus) on #11121A near-black; Roboto ExtraLight for display headlines, Roboto Bold for labels/buttons/emphasis, Roboto Regular for body; sharp-cornered outline CTAs vs rounded inputs/icon-buttons preserved; translucent periwinkle hairline borders and top-edge accent lines on cards.
STORY: a PyME/startup lead recognizes one coherent technical brand, trusts it enough to read past the hero, and converts through the contact form naming their service.
FIRST VIEWPORT: nav with isotipo + OWL/CODE wordmark; hero headline in Roboto ExtraLight, no kicker line, outline CTA + ghost link, portrait right.
FORM: brief-pinned by the user's locked brand manual (logo, #7AA2F7/#11121A, Roboto) and an approved hero/nav mockup; no concept roll — the brief overrides the workshop.
FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md.
-->
		<main>
			<Navigation />
			<slot />
			<Footer />
		</main>

<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/flowbite/1.8.0/flowbite.min.js"></script>
	</body>
</html>
<style is:global>

	html {
		font-family: 'Roboto', sans-serif;
		color-scheme: dark;
	}

	body {
		background-color: #11121A;
		background-image: radial-gradient(circle, rgba(122, 162, 247, 0.18) 1px, transparent 1px);
		background-size: 22px 22px;
		color: #F2F4FC;
	}

</style>
