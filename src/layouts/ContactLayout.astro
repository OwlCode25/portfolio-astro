---
interface Props {
	title: string;
	description?: string;
	noindex?: boolean;
}


import NavContact from '../components/NavContact.astro';

const {
	title,
	description = "¿Tienes un proyecto en mente? Escríbeme y conversemos: desarrollo de aplicaciones, automatización con IA e integración de sistemas a medida.",
	noindex = false,
} = Astro.props;

---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		{noindex && <meta name="robots" content="noindex" />}
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
		<link rel="manifest" href="/site.webmanifest">
		<meta name="generator" content={Astro.generator} />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Madimi+One&family=Oswald:wght@200..700&family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&family=Rubik:ital,wght@0,300..900;1,300..900&family=Truculenta:opsz,wght@12..72,100..900&display=swap" rel="stylesheet">
		<title>{title}</title>
	</head>
	<body>
		<main class="animate-delay-300 animate-blurred-fade-in">
			<NavContact />
			<slot />
		</main>

<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/flowbite/1.8.0/flowbite.min.js"></script>
	</body>
</html>
<style is:global>

	html {
		font-family: 'Rubik', sans-serif;
		color-scheme: dark;
	}

	body {
		background-color: #070b14;
		background-image: radial-gradient(circle, rgba(56, 189, 248, 0.18) 1px, transparent 1px);
		background-size: 22px 22px;
		color: #e2e8f0;
	}

</style>
